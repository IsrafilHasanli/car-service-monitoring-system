RTSP_URL=rtsp://username:password@camera-ip:554/stream1

# Storage and model locations
ANPR_JSON_FILE=data/queue_garage.json
ANPR_ROI_FILE=config/roi.json
ANPR_TEXT_FILE=data/entered_plates.txt
ANPR_IMAGE_DIR=data/images
ANPR_LIVE_FRAME_FILE=data/live_frame.jpg
ANPR_INFERENCE_LOG=data/anpr_inference.log
ANPR_VEHICLE_MODEL=models/yolov8n.pt
ANPR_PLATE_MODEL=models/license_plate_detector.pt

# Optional performance tuning
ANPR_FRAME_SKIP=2
ANPR_TARGET_WIDTH=1280
ANPR_VEHICLE_IMGSZ=640
ANPR_PLATE_IMGSZ=320
ANPR_OCR_EVERY_N_FRAMES=2
ANPR_LIVE_FRAME_INTERVAL=0.08
ANPR_MIN_VEHICLE_WIDTH=180
ANPR_MIN_VEHICLE_HEIGHT=90
ANPR_MIN_VEHICLE_AREA=25000
ANPR_VEHICLE_EDGE_MARGIN=12
